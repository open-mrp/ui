{
  "editor.tabSize": 4,
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.codeActionsOnSave": {
    "source.fixAll": "explicit",
    "source.organizeImports": "explicit"
  },
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.patterns": {
    "*.ts": "${capture}.test.ts, ${capture}.spec.ts, ${capture}.d.ts, ${capture}.stories.ts",
    "*.tsx": "${capture}.test.tsx, ${capture}.spec.tsx, ${capture}.d.ts, ${capture}.stories.tsx",
    "*.js": "${capture}.test.js, ${capture}.spec.js, ${capture}.d.js, ${capture}.stories.js",
    "*.jsx": "${capture}.test.jsx, ${capture}.spec.jsx, ${capture}.d.jsx, ${capture}.stories.jsx"
  },
}
