{
    "name": "@openmrp/ui",
    "description": "A collection of react components and other user interface utilities for OpenMRP.",
    "version": "3.1.0",
    "author": "Augno, Inc.",
    "type": "module",
    "main": "dist/cjs/index.js",
    "module": "dist/esm/index.js",
    "files": [
        "dist"
    ],
    "types": "dist/types/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/types/index.d.ts",
            "import": "./dist/esm/index.js",
            "require": "./dist/cjs/index.js"
        },
        "./styles.css": {
            "style": "./dist/styles.css",
            "import": "./dist/styles.css",
            "require": "./dist/styles.css",
            "default": "./dist/styles.css"
        }
    },
    "scripts": {
        "version": "changeset",
        "clean": "rimraf dist",
        "build:types": "tsc && tsc-alias",
        "build:esm": "babel src --out-dir dist/esm --extensions \".ts,.tsx\" --env-name esm",
        "build:cjs": "babel src --out-dir dist/cjs --extensions \".ts,.tsx\" --env-name cjs",
        "build:css": "rollup -c",
        "build": "bun run clean && bun run build:types && bun run build:cjs && bun run build:esm && bun run build:css",
        "release": "bun run build && bunx changeset publish",
        "check-changes": "changeset status || exit 1",
        "test": "jest",
        "storybook": "storybook dev -p 6006",
        "build:storybook": "storybook build",
        "yalc:publish": "bun run build && yalc publish --push",
        "yalc:watch": "bun run build && yalc publish --push && chokidar 'src/**/*' -c 'bun run build && yalc publish --push'",
        "link:all": "./scripts/link-all.sh",
        "unlink:all": "./scripts/unlink-all.sh",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "devDependencies": {
        "@babel/cli": "^8.0.5",
        "@babel/core": "^8.0.5",
        "@babel/preset-env": "^8.0.5",
        "@babel/preset-react": "^8.0.1",
        "@babel/preset-typescript": "^8.0.1",
        "@babel/register": "^8.0.5",
        "@changesets/cli": "^3.0.3",
        "@storybook/addon-docs": "^10.6.0",
        "@storybook/addon-onboarding": "^10.6.0",
        "@storybook/addon-themes": "^10.6.0",
        "@storybook/react-vite": "^10.6.0",
        "@tailwindcss/postcss": "^4.3.3",
        "@tailwindcss/vite": "^4.3.3",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.7",
        "@types/bun": "latest",
        "@types/jest": "^30.0.0",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.2.3",
        "@typescript/native": "npm:typescript@^7.0.2",
        "autoprefixer": "^10.6.1",
        "babel-plugin-inline-import": "^3.0.0",
        "babel-plugin-module-resolver": "^5.0.3",
        "chokidar-cli": "^3.0.0",
        "jest": "^30.5.1",
        "jest-environment-jsdom": "^30.5.1",
        "jest-raw-loader": "^1.0.1",
        "jest-transform-stub": "^2.0.0",
        "postcss": "^8.5.28",
        "prettier": "^3.9.7",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "rimraf": "^6.1.3",
        "rollup-plugin-postcss": "^4.0.2",
        "storybook": "^10.6.0",
        "tailwindcss": "^4.3.3",
        "ts-jest": "^29.4.12",
        "ts-node": "^10.9.2",
        "tsc-alias": "^1.9.5",
        "tslib": "^2.8.1",
        "tsup": "^8.5.1",
        "typescript": "npm:@typescript/typescript6@^6.0.2",
        "vite-plugin-glsl": "^1.6.1",
        "yalc": "^1.0.0-pre.53"
    },
    "peerDependencies": {
        "@xyflow/react": "^12.10.0",
        "react": "^19.2.0",
        "tailwindcss": "^4.3.3"
    },
    "dependencies": {
        "@floating-ui/react-dom": "^2.1.9",
        "@tanstack/react-virtual": "^3.14.13",
        "clsx": "^2.1.1",
        "highlight.js": "^11.11.1",
        "lucide-react": "^1.46.0",
        "tailwind-merge": "^3.7.0"
    },
    "overrides": {
        "chalk": "^4.1.2"
    },
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org/"
    },
    "license": "Apache-2.0"
}
