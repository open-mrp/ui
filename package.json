{
    "name": "@augno/ui",
    "description": "A collection of react components and other user interface utilities for Augno.",
    "version": "1.9.11",
    "author": "Augno, Inc.",
    "type": "module",
    "main": "dist/cjs/index.js",
    "module": "dist/esm/index.js",
    "files": [
        "dist"
    ],
    "types": "dist/types/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/types/index.d.ts",
            "import": "./dist/esm/index.js",
            "require": "./dist/cjs/index.js"
        },
        "./styles.css": {
            "style": "./dist/styles.css",
            "import": "./dist/styles.css",
            "require": "./dist/styles.css",
            "default": "./dist/styles.css"
        }
    },
    "scripts": {
        "version": "changeset",
        "clean": "rimraf dist",
        "build:types": "tsc && tsc-alias",
        "build:esm": "babel src --out-dir dist/esm --extensions \".ts,.tsx\" --env-name esm",
        "build:cjs": "babel src --out-dir dist/cjs --extensions \".ts,.tsx\" --env-name cjs",
        "build:css": "rollup -c",
        "build": "bun run clean && bun run build:types && bun run build:cjs && bun run build:esm && bun run build:css",
        "release": "bun run build && bunx changeset publish",
        "check-changes": "changeset status || exit 1",
        "test": "jest",
        "storybook": "storybook dev -p 6006",
        "build:storybook": "storybook build",
        "yalc:publish": "bun run build && yalc publish --push",
        "yalc:watch": "bun run build && yalc publish --push && chokidar 'src/**/*' -c 'bun run build && yalc publish --push'",
        "link:all": "./scripts/link-all.sh",
        "unlink:all": "./scripts/unlink-all.sh",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "devDependencies": {
        "@babel/cli": "^7.29.7",
        "@babel/core": "^7.29.7",
        "@babel/preset-env": "^7.29.7",
        "@babel/preset-react": "^7.29.7",
        "@babel/preset-typescript": "^7.29.7",
        "@babel/register": "^7.29.7",
        "@changesets/cli": "^2.31.0",
        "@storybook/addon-docs": "^10.4.6",
        "@storybook/addon-onboarding": "^10.4.6",
        "@storybook/addon-themes": "^10.4.6",
        "@storybook/react-vite": "^10.4.6",
        "@tailwindcss/postcss": "^4.3.1",
        "@tailwindcss/vite": "^4.3.1",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.2",
        "@testing-library/user-event": "^14.6.1",
        "@types/bun": "latest",
        "@types/jest": "^29.5.14",
        "@types/react": "^19.2.17",
        "autoprefixer": "^10.5.0",
        "babel-plugin-inline-import": "^3.0.0",
        "babel-plugin-module-resolver": "^5.0.3",
        "chokidar-cli": "^3.0.0",
        "jest": "^29.7.0",
        "jest-environment-jsdom": "^29.7.0",
        "jest-raw-loader": "^1.0.1",
        "jest-transform-stub": "^2.0.0",
        "postcss": "^8.5.15",
        "prettier": "^3.8.4",
        "react": "^19.2.7",
        "react-dom": "^19.2.7",
        "rimraf": "^6.1.3",
        "rollup-plugin-postcss": "^4.0.2",
        "storybook": "^10.4.6",
        "ts-jest": "^29.4.11",
        "ts-node": "^10.9.2",
        "tsc-alias": "^1.8.17",
        "tslib": "^2.8.1",
        "tsup": "^8.5.1",
        "typescript": "^5.9.3",
        "vite-plugin-glsl": "^1.6.0",
        "yalc": "^1.0.0-pre.53"
    },
    "peerDependencies": {
        "react": "^19.0.0",
        "@xyflow/react": "^12.10.0"
    },
    "dependencies": {
        "@radix-ui/react-accordion": "^1.2.14",
        "@radix-ui/react-checkbox": "^1.3.5",
        "@radix-ui/react-dialog": "^1.1.17",
        "@radix-ui/react-dropdown-menu": "^2.1.18",
        "@radix-ui/react-popover": "^1.1.17",
        "@radix-ui/react-radio-group": "^1.4.1",
        "@radix-ui/react-select": "^2.3.1",
        "@radix-ui/react-switch": "^1.3.1",
        "@radix-ui/react-tabs": "^1.1.15",
        "@radix-ui/react-tooltip": "^1.2.10",
        "@tanstack/react-virtual": "^3.14.3",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "copy-to-clipboard": "^3.3.3",
        "lucide-react": "^0.546.0",
        "rehype-highlight": "^7.0.2",
        "rehype-parse": "^9.0.1",
        "rehype-stringify": "^10.0.1",
        "tailwind-merge": "^3.6.0",
        "tailwindcss": "^4.3.1",
        "unified": "^11.0.5",
        "zustand": "^5.0.14"
    },
    "overrides": {
        "chalk": "^4.1.2"
    }
}
